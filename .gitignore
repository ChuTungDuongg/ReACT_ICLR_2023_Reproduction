# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Local environment and credentials
.env
.env.*
!.env.example

# Tests, coverage, and linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Editors and operating systems
.DS_Store
Thumbs.db
.vscode/
.idea/

# Experiment artifacts (retain the directory marker)
outputs/*
!outputs/.gitkeep
!outputs/README.md
!outputs/README.vi.md
!outputs/hotpotqa/

# Local ML data, caches, models, and checkpoints
data/
cache/
tmp/
models/
checkpoints/
wandb/
mlruns/

# Logs and model artifacts
*.log
*.bin
*.pt
*.pth
*.safetensors

# Keep all HotpotQA benchmark outcomes, including run logs
!outputs/hotpotqa/**

# Keep all FEVER benchmark outcomes, including run logs
!outputs/fever/
!outputs/fever/**

# Notebook residue (not part of this workflow)
.ipynb_checkpoints/
